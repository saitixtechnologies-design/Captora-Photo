# Copy this file to backend/.env for local work, and to backend/.env.production for the live server.
# Never put real passwords or secrets in this example file; it is committed to Git.

# Local: development. Live (.env.production): production.
NODE_ENV=development
PORT=4000
# MongoDB Atlas connection string (Atlas -> Connect -> Drivers). Put the database name (e.g. captora) before the '?'.
MONGO_URI=mongodb+srv://<db-user>:<db-password>@<cluster-host>/captora?retryWrites=true&w=majority
# Random string of at least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=<random-64-byte-hex>
JWT_EXPIRES_IN=8h
# Local: http://localhost:5173
# Live: https://captoraphotography.com,https://www.captoraphotography.com,https://saitix-001-site2.ftempurl.com
FRONTEND_ORIGIN=http://localhost:5173
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=100
RESET_LINK_DEV_MODE=false
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
ADMIN_EMAIL=
# Only needed once for `npm run create-admin`; delete it afterwards.
ADMIN_PASSWORD=
