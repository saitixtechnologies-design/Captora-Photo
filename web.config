<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS config for MyWindowsHosting. Upload this file to the site root (next to the backend folder).
  IIS starts Node through HttpPlatformHandler and passes the port in HTTP_PLATFORM_PORT.
  Live settings are read from backend/.env.production (upload it by FTP; never commit it).
-->
<configuration>
  <system.webServer>
    <handlers>
      <add name="httpPlatformHandler" path="*" verb="*" modules="httpPlatformHandler" resourceType="Unspecified" />
    </handlers>
    <httpPlatform processPath="node.exe"
                  arguments=".\backend\src\server.js"
                  startupTimeLimit="60"
                  startupRetryCount="3"
                  stdoutLogEnabled="true"
                  stdoutLogFile=".\logs\node">
      <environmentVariables>
        <environmentVariable name="NODE_ENV" value="production" />
        <environmentVariable name="DOTENV_CONFIG_PATH" value=".env.production" />
      </environmentVariables>
    </httpPlatform>
    <security>
      <requestFiltering>
        <!-- Admin video uploads can be large (value in bytes, ~1 GB). -->
        <requestLimits maxAllowedContentLength="1073741824" />
        <hiddenSegments>
          <add segment="node_modules" />
          <add segment=".env" />
          <add segment=".env.production" />
        </hiddenSegments>
      </requestFiltering>
    </security>
  </system.webServer>
</configuration>
